# Optional server-only market feed. Keep both values empty to use public
# read-only fallbacks. Never prefix either variable with NEXT_PUBLIC_.
ODDSFRONT_MARKET_FEED_URL=
ODDSFRONT_MARKET_FEED_TOKEN=

# Optional server-only DropsTab API credential. The application works without
# it and never sends this value to the browser.
DROPSTAB_API_KEY=

# Optional ownership meta tags for search-engine webmaster consoles. The
# existing Google HTML verification file remains valid; set these only when a
# provider gives the canonical oddsfront.com property a new verification code.
ODDSFRONT_GOOGLE_SITE_VERIFICATION=
ODDSFRONT_BING_SITE_VERIFICATION=
ODDSFRONT_YANDEX_SITE_VERIFICATION=
ODDSFRONT_NAVER_SITE_VERIFICATION=
ODDSFRONT_BAIDU_SITE_VERIFICATION=
