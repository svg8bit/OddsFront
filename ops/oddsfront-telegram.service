[Unit]
Description=Publish one verified OddsFront news and market Telegram post
After=network-online.target
Wants=network-online.target
ConditionPathExists=/root/OddsFront/.local/telegram.env

[Service]
Type=oneshot
WorkingDirectory=/root/OddsFront
ExecStart=/usr/local/bin/node scripts/news/telegram.ts --send
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/root/OddsFront/.local/telegram.env
Nice=10
CPUQuota=100%
MemoryMax=2G
TasksMax=256
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/OddsFront/.local/news /root/.codex
InaccessiblePaths=-/opt/arctrenches -/opt/arctrenches-legacy-6c13c07 -/root/DropsAnalytics-worktrees -/opt/sunder -/root/.ssh
UMask=0077
TimeoutStartSec=5min
