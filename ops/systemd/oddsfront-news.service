[Unit]
Description=OddsFront verified geopolitics news publisher
After=network-online.target
Wants=network-online.target
ConditionPathExists=/root/OddsFront/scripts/news/publish.ts

[Service]
Type=oneshot
WorkingDirectory=/root/OddsFront
ExecStart=/usr/bin/env node scripts/news/run-edition.mjs --with-followups
Environment=NODE_ENV=production
# The editorial writer runs on the owner's Claude subscription (ODDSFRONT_WRITER=codex
# selects the Codex CLI instead). One ten-story edition per day on this VPS.
Environment=ODDSFRONT_WRITER=claude
Environment=ODDSFRONT_NEWS_EDITION_INTERVAL_HOURS=24
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
Nice=10
CPUQuota=100%
MemoryMax=3G
TasksMax=256
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/OddsFront/.local/news /opt/oddsfront-market-feed/news /root/.codex /root/.claude
InaccessiblePaths=-/opt/arctrenches -/opt/arctrenches-legacy-6c13c07 -/root/DropsAnalytics -/root/DropsAnalytics-worktrees -/opt/sunder -/root/.ssh -/etc/oddsfront-market-feed.env
UMask=0077
TimeoutStartSec=150min
