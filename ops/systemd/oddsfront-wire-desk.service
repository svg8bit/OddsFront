[Unit]
Description=OddsFront website wire desk: original EN/RU articles from the hottest outlet stories
Documentation=file:///root/OddsFront/docs/news-wire-desk.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/root/OddsFront/scripts/news/wire-desk.ts

[Service]
Type=oneshot
WorkingDirectory=/root/OddsFront
ExecStart=/usr/bin/env node scripts/news/wire-desk.ts --publish --retire-seed
Environment=NODE_ENV=production
Environment=HOME=/root
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
# Root-only (0600): ODDSFRONT_NEWS_REVALIDATE_TOKEN (same value as the Vercel
# variable) and optional ODDSFRONT_WIRE_DESK_* knobs. Without it pages refresh
# on their ISR windows instead of at once.
EnvironmentFile=-/etc/oddsfront/wire-desk.env
Nice=10
CPUQuota=100%
MemoryMax=2G
TasksMax=512
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/OddsFront/.local/news /opt/oddsfront-market-feed/news /root/.claude -/root/.claude.json
InaccessiblePaths=-/opt/arctrenches -/opt/arctrenches-legacy-6c13c07 -/root/DropsAnalytics -/root/DropsAnalytics-worktrees -/opt/sunder -/root/.ssh -/etc/oddsfront-market-feed.env
UMask=0077
TimeoutStartSec=20min
