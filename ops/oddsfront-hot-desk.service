[Unit]
Description=Post the hottest OddsFront story with its live market and one-tap bet buttons to Telegram
After=network-online.target
Wants=network-online.target
ConditionPathExists=/root/OddsFront/.local/telegram.env

[Service]
Type=oneshot
WorkingDirectory=/root/OddsFront
ExecStart=/usr/bin/env node scripts/news/hot-desk.ts --send
Environment=NODE_ENV=production
Environment=HOME=/root
Environment=ODDSFRONT_WRITER=claude
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/root/OddsFront/.local/telegram.env
Nice=10
CPUQuota=100%
MemoryMax=2G
TasksMax=512
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/OddsFront/.local/news /root/.claude -/root/.claude.json
InaccessiblePaths=-/opt/arctrenches -/opt/arctrenches-legacy-6c13c07 -/root/DropsAnalytics-worktrees -/opt/sunder -/root/.ssh
UMask=0077
TimeoutStartSec=10min
