{
  "name": "oddsfront",
  "version": "1.0.0",
  "description": "Live map of conflict and geopolitics prediction markets.",
  "private": true,
  "license": "UNLICENSED",
  "homepage": "https://oddsfront.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svg8bit/OddsFront.git"
  },
  "bugs": {
    "url": "https://github.com/svg8bit/OddsFront/issues"
  },
  "scripts": {
    "task:start": "node scripts/start-task.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "generate:country-anchors": "node scripts/generate-country-anchors.mjs",
    "generate:map-assets": "node scripts/optimize-map-assets.mjs --write",
    "generate:map-font": "node scripts/generate-map-font.mjs",
    "check:map-assets": "node scripts/optimize-map-assets.mjs --check",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:map-assets && npm run test:readership && npm run lint && npm run typecheck && npm run build",
    "test:readership": "python3 ops/market-feed/test_news_readership.py",
    "test:e2e": "playwright test",
    "benchmark:map": "node scripts/benchmark-map-performance.mjs",
    "test:visual:reference": "node scripts/compare-map-reference.mjs",
    "news:publish": "node scripts/news/publish.ts",
    "news:translate": "/root/OddsFront/.local/translation-venv/bin/python scripts/news/translate.py",
    "news:indexnow": "node scripts/news/indexnow.mjs",
    "test:news": "playwright test tests/news-publication.spec.ts tests/news-interface.spec.ts",
    "generate:localized-map-assets": "node scripts/generate-localized-map-assets.mjs",
    "news:edition": "node scripts/news/run-edition.mjs",
    "news:telegram": "node scripts/news/telegram.ts"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "lucide-react": "1.28.0",
    "maplibre-gl": "6.1.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-map-gl": "8.1.2",
    "sharp": "0.35.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.4",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
}
